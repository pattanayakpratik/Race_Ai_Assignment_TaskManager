# Copy to .env and adjust if needed:  cp .env.example .env
# Both docker-compose.yml and config/settings.py read this file.

# --- Django ---
DJANGO_SECRET_KEY=django-insecure-change-me-for-anything-but-local-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ---
# DB_HOST/DB_PORT are how Django reaches the container from the host.
DB_NAME=taskmanager
DB_USER=taskmanager
DB_PASSWORD=taskmanager
DB_HOST=127.0.0.1
DB_PORT=3307

# Only used by docker-compose.yml when creating the container.
MYSQL_ROOT_PASSWORD=rootpassword
